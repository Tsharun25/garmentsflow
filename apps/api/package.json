{
  "name": "@garmentflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run tests/health.test.ts",
    "test:integration": "tsx scripts/test-postgres.ts",
    "db:migrate": "tsx src/admin-cli.ts migrate",
    "db:provision": "tsx src/admin-cli.ts provision"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
