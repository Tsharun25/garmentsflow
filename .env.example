# Local Docker only. Generate three different private random values.
# Use URL-safe hexadecimal passwords because these values are interpolated into connection URLs.
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_RANDOM_HEX
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_PRIVATE_RANDOM_HEX
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
